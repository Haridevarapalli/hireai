<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/onboarding_page_visual"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.46"
        android:background="@drawable/bg_onboarding_visual">

        <ImageView
            android:id="@+id/onboarding_page_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:contentDescription="Onboarding visual"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_robot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.54"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/onboarding_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HireAI: The Future of Hiring"
            android:textAlignment="center"
            android:textColor="@color/text_on_dark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboarding_page_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="The only ATS built specifically for the next generation of CSE talent."
            android:textAlignment="center"
            android:textColor="@color/text_muted_on_dark"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
