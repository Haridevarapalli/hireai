<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/hr_clear_close"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:contentDescription="Close"
        android:src="@drawable/ic_close"
        android:tint="@color/text_on_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hr_clear_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HR Round"
        android:textColor="@color/text_on_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/hr_clear_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/hr_clear_close" />

    <TextView
        android:id="@+id/hr_clear_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="HR Round Cleared!"
        android:textColor="@color/text_on_dark"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hr_clear_title"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/hr_clear_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your personality profile matches our\nrequirements."
        android:textColor="@color/text_muted_on_dark"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hr_clear_heading"
        app:layout_constraintWidth_percent="0.88" />

    <FrameLayout
        android:id="@+id/hr_clear_image"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_image_placeholder_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hr_clear_body"
        app:layout_constraintWidth_percent="0.88">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:contentDescription="Trophy"
            android:src="@drawable/ic_trophy" />
    </FrameLayout>

    <Button
        android:id="@+id/hr_clear_next"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="Proceed to Technical Round"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.88" />

</androidx.constraintlayout.widget.ConstraintLayout>
