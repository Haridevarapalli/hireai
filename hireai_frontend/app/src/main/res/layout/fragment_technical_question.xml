<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/tech_close"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:contentDescription="Close"
        android:src="@drawable/ic_close"
        android:tint="@color/text_on_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tech_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Technical (28)"
        android:textColor="@color/text_on_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tech_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tech_close" />

    <TextView
        android:id="@+id/tech_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:text="8/10"
        android:textColor="@color/text_muted_on_dark"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tech_title" />

    <ProgressBar
        android:id="@+id/tech_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="10dp"
        android:progress="80"
        android:progressDrawable="@drawable/progress_horizontal_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tech_counter"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/tech_question_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_on_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tech_progress"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/tech_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/text_muted_on_dark"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tech_question_title"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/tech_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_code_block"
        android:padding="16dp"
        android:text=""
        android:textColor="@color/text_on_dark"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/tech_question_title"
        app:layout_constraintStart_toStartOf="@id/tech_question_title"
        app:layout_constraintTop_toBottomOf="@id/tech_prompt" />

    <LinearLayout
        android:id="@+id/tech_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/tech_question_title"
        app:layout_constraintStart_toStartOf="@id/tech_question_title"
        app:layout_constraintTop_toBottomOf="@id/tech_code" />

    <Button
        android:id="@+id/tech_next"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.88" />

</androidx.constraintlayout.widget.ConstraintLayout>
