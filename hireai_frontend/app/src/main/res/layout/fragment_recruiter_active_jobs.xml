<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recruiter_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/recruiter_jobs_toolbar"
        style="@style/Widget.HireAI.Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Active Jobs" />

    <ImageButton
        android:id="@+id/recruiter_jobs_filter"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Filter jobs"
        android:padding="@dimen/spacing_12"
        android:src="@drawable/ic_filter"
        android:tint="@color/recruiter_toolbar_icon"
        app:layout_constraintBottom_toBottomOf="@id/recruiter_jobs_toolbar"
        app:layout_constraintEnd_toEndOf="@id/recruiter_jobs_toolbar"
        app:layout_constraintTop_toTopOf="@id/recruiter_jobs_toolbar" />

    <LinearLayout
        android:id="@+id/recruiter_jobs_search_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_16"
        android:background="@drawable/bg_recruiter_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_jobs_toolbar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/recruiter_jobs_search_input"
            style="@style/TextAppearance.HireAI.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search jobs"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/recruiter_jobs_search_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recruiter_jobs_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_8"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_24"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_jobs_search_container" />

    <ProgressBar
        android:id="@+id/recruiter_jobs_loading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recruiter_jobs_list"
        app:layout_constraintEnd_toEndOf="@id/recruiter_jobs_list"
        app:layout_constraintStart_toStartOf="@id/recruiter_jobs_list"
        app:layout_constraintTop_toTopOf="@id/recruiter_jobs_list" />

    <include
        android:id="@+id/recruiter_jobs_state"
        layout="@layout/view_list_state"
        app:layout_constraintBottom_toBottomOf="@id/recruiter_jobs_list"
        app:layout_constraintEnd_toEndOf="@id/recruiter_jobs_list"
        app:layout_constraintStart_toStartOf="@id/recruiter_jobs_list"
        app:layout_constraintTop_toTopOf="@id/recruiter_jobs_list" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/recruiter_jobs_post_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="+ Post Job"
        android:textAllCaps="false"
        app:backgroundTint="@color/primary_blue"
        app:iconTint="@color/white"
        app:rippleColor="#33FFFFFF"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
