<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:paddingTop="@dimen/spacing_24"
    android:paddingStart="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_24">

    <TextView
        android:id="@+id/parsing_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HireAI"
        android:textColor="@color/text_on_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/parsing_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:tint="@color/text_on_dark"
        app:layout_constraintBottom_toBottomOf="@id/parsing_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/parsing_header" />

    <TextView
        android:id="@+id/parsing_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="AI Parsing in Progress"
        android:textColor="@color/text_on_dark"
        android:textSize="42sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parsing_header"
        app:layout_constraintWidth_percent="0.94" />

    <TextView
        android:id="@+id/parsing_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="Our AI is meticulously analyzing the resume to\nextract key information and assess its\nrelevance to the role."
        android:textColor="@color/text_muted_on_dark"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parsing_title"
        app:layout_constraintWidth_percent="0.94" />

    <FrameLayout
        android:id="@+id/parsing_image"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/bg_image_placeholder_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parsing_desc"
        app:layout_constraintWidth_percent="0.94">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:contentDescription="Document"
            android:src="@drawable/ic_neon_doc" />
    </FrameLayout>

    <TextView
        android:id="@+id/parsing_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="Extracting skills..."
        android:textColor="@color/text_muted_on_dark"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parsing_image" />

    <TextView
        android:id="@+id/parsing_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="50%"
        android:textColor="@color/text_on_dark"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/parsing_image"
        app:layout_constraintTop_toBottomOf="@id/parsing_status" />

    <ProgressBar
        android:id="@+id/parsing_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="@dimen/spacing_8"
        android:progress="50"
        android:progressDrawable="@drawable/progress_horizontal_dark"
        app:layout_constraintEnd_toEndOf="@id/parsing_image"
        app:layout_constraintStart_toStartOf="@id/parsing_image"
        app:layout_constraintTop_toBottomOf="@id/parsing_percent" />

    <Button
        android:id="@+id/parsing_cancel"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/spacing_12"
        android:background="@drawable/bg_card_dark"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_on_dark"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/parsing_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintWidth_percent="0.45" />

    <Button
        android:id="@+id/parsing_next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/spacing_12"
        android:layout_marginStart="@dimen/spacing_12"
        android:background="@drawable/bg_button_primary"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/parsing_cancel"
        app:layout_constraintWidth_percent="0.45" />

</androidx.constraintlayout.widget.ConstraintLayout>


