<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_8"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_24">

    <TextView
        android:id="@+id/step2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 2 of 3"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/step2_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="24dp"
        android:text="Generating Question\nBank"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step2_title"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/step2_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="10dp"
        android:text="Selecting the most relevant HR &amp; behavioral\nquestions based on your background."
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step2_header"
        app:layout_constraintWidth_percent="0.88" />

    <FrameLayout
        android:id="@+id/step2_image"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_image_placeholder_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step2_subtitle"
        app:layout_constraintWidth_percent="0.88">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="Brain"
            android:src="@drawable/ic_brain" />
    </FrameLayout>

    <TextView
        android:id="@+id/step2_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="16dp"
        android:text="Generating Questions"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step2_image"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/step2_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="10dp"
        android:progress="60"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step2_label"
        app:layout_constraintWidth_percent="0.88" />

</androidx.constraintlayout.widget.ConstraintLayout>


