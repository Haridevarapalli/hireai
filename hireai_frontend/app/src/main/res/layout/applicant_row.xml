<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="84dp"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_12"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_12">

    <ImageView
        android:id="@+id/applicant_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_profile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/applicant_name"
        style="@style/TextAppearance.HireAI.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/applicant_match"
        app:layout_constraintStart_toEndOf="@id/applicant_avatar"
        app:layout_constraintTop_toTopOf="@id/applicant_avatar" />

    <TextView
        android:id="@+id/applicant_subtitle"
        style="@style/TextAppearance.HireAI.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginTop="@dimen/spacing_4"
        app:layout_constraintEnd_toStartOf="@id/applicant_match"
        app:layout_constraintStart_toEndOf="@id/applicant_avatar"
        app:layout_constraintTop_toBottomOf="@id/applicant_name" />

    <TextView
        android:id="@+id/applicant_match"
        style="@style/TextAppearance.HireAI.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/applicant_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/applicant_avatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
