<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_8"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_24">

    <TextView
        android:id="@+id/step1_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1/3"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/step1_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="24dp"
        android:text="Synthesizing your profile"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step1_title"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/step1_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="10dp"
        android:text="Mapping your experience to the HR\nassessment database."
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step1_header"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/step1_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"        android:layout_marginTop="24dp"
        android:text="Analyzing Resume Context"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step1_subtitle"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/step1_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="10dp"
        android:progress="20"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step1_label"
        app:layout_constraintWidth_percent="0.88" />

</androidx.constraintlayout.widget.ConstraintLayout>


