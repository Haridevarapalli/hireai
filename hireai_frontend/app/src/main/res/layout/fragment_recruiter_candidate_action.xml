<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recruiter_surface"
    android:paddingBottom="@dimen/spacing_24">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/recruiter_candidate_action_toolbar"
        style="@style/Widget.HireAI.Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Candidate Action" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recruiter_candidate_action_card"
        style="@style/Widget.HireAI.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_16">

            <ImageView
                android:id="@+id/recruiter_candidate_action_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_8"
                android:src="@drawable/ic_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/recruiter_candidate_action_name"
                style="@style/TextAppearance.HireAI.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:text="Ethan Harper"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/recruiter_candidate_action_avatar"
                app:layout_constraintTop_toTopOf="@id/recruiter_candidate_action_avatar" />

            <TextView
                android:id="@+id/recruiter_candidate_action_role"
                style="@style/TextAppearance.HireAI.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="Software Engineer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/recruiter_candidate_action_avatar"
                app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_name" />

            <TextView
                android:id="@+id/recruiter_candidate_action_meta"
                style="@style/TextAppearance.HireAI.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="Applied candidate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/recruiter_candidate_action_avatar"
                app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_role" />

            <TextView
                android:id="@+id/recruiter_candidate_action_status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@drawable/bg_chip_subtle"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                android:text="APPLIED"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/recruiter_candidate_action_avatar"
                app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_meta" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recruiter_candidate_reject_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginEnd="@dimen/spacing_16"
        android:minHeight="@dimen/button_height"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        android:gravity="center"
        android:text="Reject Candidate"
        android:textAllCaps="false"
        android:textColor="@color/danger_red"
        android:textSize="16sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:cornerRadius="@dimen/radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_card"
        app:strokeColor="@color/danger_red" />

    <TextView
        android:id="@+id/recruiter_candidate_action_guidance"
        style="@style/TextAppearance.HireAI.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_16"
        android:gravity="center_horizontal"
        android:text="Review candidate stage and choose the next valid action."
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_reject_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recruiter_candidate_accept_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_16"
        android:minHeight="@dimen/button_height"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        android:gravity="center"
        android:text="Shortlist / Accept"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="@dimen/radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recruiter_candidate_action_guidance" />

</androidx.constraintlayout.widget.ConstraintLayout>
