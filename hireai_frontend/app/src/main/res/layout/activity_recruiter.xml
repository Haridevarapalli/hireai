<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/recruiter_nav_host"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/recruiter_nav_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/recruiter_nav_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/recruiter_stroke"
        app:layout_constraintBottom_toTopOf="@id/recruiter_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/recruiter_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/recruiter_card"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_item_tint"
        app:itemPaddingBottom="6dp"
        app:itemPaddingTop="6dp"
        app:itemRippleColor="@color/nav_ripple"
        app:itemTextColor="@color/nav_item_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.HireAI.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.HireAI.BottomNav.Inactive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_recruiter_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
