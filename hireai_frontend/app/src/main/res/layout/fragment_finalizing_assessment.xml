<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <TextView
        android:id="@+id/final_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finalizing Assessment"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/final_resume_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Resume Analysis"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_title"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/final_resume_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_resume_label"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/final_skill_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Skill Assessment"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_resume_progress"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/final_skill_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_skill_label"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/final_coding_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Coding Challenge"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_skill_progress"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/final_coding_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_coding_label"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/final_comm_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Communication"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_coding_progress"
        app:layout_constraintWidth_percent="0.88" />

    <ProgressBar
        android:id="@+id/final_comm_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:progressDrawable="@drawable/progress_horizontal_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_comm_label"
        app:layout_constraintWidth_percent="0.88" />

    <TextView
        android:id="@+id/final_ready"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="HR Round Ready!"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_comm_progress"
        app:layout_constraintWidth_percent="0.88" />

    <Button
        android:id="@+id/final_enter"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="Enter HR Round"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.86" />

</androidx.constraintlayout.widget.ConstraintLayout>

